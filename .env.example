# Variables de entorno para produccion (Vercel)
# Copia estas variables en el panel de Vercel > Settings > Environment Variables

# Base de datos Turso (obtenida en https://turso.tech)
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui

# Contraseña del panel de administración (cámbiala)
ADMIN_PASSWORD=tarija2024

# Clave secreta para las sesiones (pon cualquier texto largo y random)
SESSION_SECRET=cualquier-texto-secreto-largo-aqui-2024
